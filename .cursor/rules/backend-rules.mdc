## 9. Error Handling

### 9.1 Error Types

```go
// internal/shared/errors/errors.go
package errors

import "fmt"

type DomainError struct {
    Code    string
    Message string
    Cause   error
}

func (e *DomainError) Error() string {
    if e.Cause != nil {
        return fmt.Sprintf("%s: %s: %v", e.Code, e.Message, e.Cause)
    }
    return fmt.Sprintf("%s: %s", e.Code, e.Message)
}

func (e *DomainError) Unwrap() error {
    return e.Cause
}
```

### 9.2 Domain-Specific Errors

```go
// internal/common/errors/errors.go
package errors

import "fmt"

type DomainError struct {
    Code    string
    Message string
    Cause   error
}

func NewDomainError(code, message string) *DomainError {
    return &DomainError{
        Code:    code,
        Message: message,
    }
}

// Usage in services
var (
    ErrUserNotFound = errors.NewDomainError("USER_NOT_FOUND", "user not found")
    ErrInvalidEmail = errors.NewDomainError("INVALID_EMAIL", "invalid email format")
    ErrUserAlreadyExists = errors.NewDomainError("USER_ALREADY_EXISTS", "user with this email already exists")
)
```

### 9.3 Error Handling in Services

```go
func (s *CreateUserService) Execute(ctx context.Context, cmd CreateUserCmd) (*CreateUserCmdOutputData, error) {
    user, err := s.userRepo.FindByEmail(ctx, cmd.Email)
    if err != nil && !errors.Is(err, errors.NewDomainError("USER_NOT_FOUND", "")) {
        return nil, fmt.Errorf("failed to check user existence: %w", err)
    }
    
    if user != nil {
        return nil, errors.NewDomainError("USER_ALREADY_EXISTS", "user with this email already exists")
    }
    
    // Continue with creation
}
```

