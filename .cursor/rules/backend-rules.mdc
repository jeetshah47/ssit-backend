### 10.4 Route Organization

**Important**: All routes must use `api.Handle` or `api.HandleWithStatus` wrapper functions.

```go
// internal/interfaces/http/routes/routes.go
package routes

import (
    "net/http"
    "github.com/gin-gonic/gin"
    "github.com/equitywala/backend/internal/interfaces/http/api"
    "github.com/equitywala/backend/internal/interfaces/http/handlers"
    "github.com/equitywala/backend/internal/interfaces/http/middleware"
)

func SetupRoutes(router *gin.Engine, deps *Dependencies) {
    apiGroup := router.Group("/api/v1")
    
    // Auth routes (no authentication required)
    authHandler := handlers.NewAuthHandler(deps.AuthService)
    auth := apiGroup.Group("/auth")
    {
        // Use api.Handle wrapper - handler signature: func(ctx *api.Context) (interface{}, error)
        auth.POST("/login", api.Handle(authHandler.Login))
        auth.POST("/signup", api.Handle(authHandler.Signup))
        auth.POST("/verify-otp", api.Handle(authHandler.VerifyOTP))
    }
    
    // User routes (authentication required)
    userHandler := handlers.NewUserHandler(deps.CreateUserHandler, deps.GetUserHandler)
    users := apiGroup.Group("/users")
    users.Use(middleware.AuthMiddleware())
    {
        // Use api.HandleWithStatus for custom HTTP status codes
        users.POST("", api.HandleWithStatus(http.StatusCreated, userHandler.CreateUser))
        users.GET("/:id", api.Handle(userHandler.GetUser))
        users.PUT("/:id", api.Handle(userHandler.UpdateUser))
        users.DELETE("/:id", api.Handle(userHandler.DeleteUser))
        users.GET("", api.Handle(userHandler.ListUsers))
    }
    
    // KYC routes
    kycHandler := handlers.NewKYCHandler(deps.CreateKYCHandler, deps.GetKYCStatusHandler)
    kyc := apiGroup.Group("/kyc")
    kyc.Use(middleware.AuthMiddleware())
    {
        kyc.POST("", api.HandleWithStatus(http.StatusCreated, kycHandler.SubmitKYC))
        kyc.GET("/status", api.Handle(kycHandler.GetKYCStatus))
    }
    
    // Subscription routes
    subscriptionHandler := handlers.NewSubscriptionHandler(deps.SubscriptionService)
    subscriptions := apiGroup.Group("/subscriptions")
    subscriptions.Use(middleware.AuthMiddleware())
    {
        subscriptions.GET("/packages", api.Handle(subscriptionHandler.ListPackages))
        subscriptions.POST("/purchase", api.HandleWithStatus(http.StatusCreated, subscriptionHandler.Purchase))
        subscriptions.GET("/status", api.Handle(subscriptionHandler.GetStatus))
    }
}
```

### 10.5 Testing Handlers with API Wrapper

When testing handlers that use the `api.Handle` wrapper, you can test the handler function directly or test through the HTTP layer.

#### 10.5.1 Direct Handler Testing

```go
// internal/interfaces/http/handlers/user_handler_test.go
package handlers

import (
    "net/http/httptest"
    "strings"
    "testing"
    "github.com/gin-gonic/gin"
    "github.com/stretchr/testify/assert"
    "github.com/stretchr/testify/mock"
    "github.com/equitywala/backend/internal/interfaces/http/api"
)

func TestUserHandler_CreateUser(t *testing.T) {
    // Arrange
    mockCreateHandler := &MockCreateUserHandler{}
    mockGetHandler := &MockGetUserHandler{}
    
    handler := NewUserHandler(mockCreateHandler, mockGetHandler)
    
    // Create mock gin context
    gin.SetMode(gin.TestMode)
    c, _ := gin.CreateTestContext(nil)
    
    // Create api context
    ctx := api.NewContext(c)
    
    // Set request body
    c.Request = httptest.NewRequest("POST", "/users", strings.NewReader(`{
        "email": "test@example.com",
        "phone": "1234567890",
        "name": "Test User"
    }`))
    c.Request.Header.Set("Content-Type", "application/json")
    
    // Mock handler behavior
    mockCreateHandler.On("Handle", mock.Anything, mock.Anything).Return(nil)
    
    // Act
    result, err := handler.CreateUser(ctx)
    
    // Assert
    assert.NoError(t, err)
    assert.NotNil(t, result)
    mockCreateHandler.AssertExpectations(t)
}
```

