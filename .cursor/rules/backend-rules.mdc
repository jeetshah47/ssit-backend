func TestUserController_CreateUser(t *testing.T) {
    // Arrange
    mockCreateService := &MockCreateUserService{}
    mockGetService := &MockGetUserService{}
    
    controller := NewUserController(mockCreateService, mockGetService)
    
    // Create mock gin context
    gin.SetMode(gin.TestMode)
    c, _ := gin.CreateTestContext(nil)
    
    // Create api context
    ctx := api.NewContext(c)
    
    // Set request body
    c.Request = httptest.NewRequest("POST", "/users", strings.NewReader(`{
        "email": "test@example.com",
        "phone": "1234567890",
        "name": "Test User"
    }`))
    c.Request.Header.Set("Content-Type", "application/json")
    
    // Mock service behavior
    mockCreateService.On("Execute", mock.Anything, mock.Anything).Return(&services.CreateUserCmdOutputData{...}, nil)
    
    // Act
    result, err := controller.CreateUser(ctx)
    
    // Assert
    assert.NoError(t, err)
    assert.NotNil(t, result)
    mockCreateService.AssertExpectations(t)
}
