admin.Use(middleware.AuthMiddleware())
admin.Use(middleware.RoleBasedMiddleware("admin", "super_admin"))
{
    admin.POST("/packages", api.Handle(adminHandler.CreatePackage))
    admin.PUT("/packages/:id", api.Handle(adminHandler.UpdatePackage))
}
