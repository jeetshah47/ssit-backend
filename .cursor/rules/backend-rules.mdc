## 8. Testing Standards

### 8.1 Unit Test Structure

```go
func TestCreateUserHandler_Handle(t *testing.T) {
    // Arrange
    mockRepo := &MockUserRepository{}
    mockValidator := &MockUserValidator{}
    handler := NewCreateUserHandler(mockRepo, mockValidator)
    
    cmd := CreateUserCommand{
        Email: "test@example.com",
        Phone: "1234567890",
    }
    
    // Act
    err := handler.Handle(context.Background(), cmd)
    
    // Assert
    assert.NoError(t, err)
    assert.True(t, mockRepo.CreateCalled)
}
```

### 8.2 Table-Driven Tests

```go
func TestCreateUserHandler_Handle_ValidationErrors(t *testing.T) {
    tests := []struct {
        name    string
        cmd     CreateUserCommand
        wantErr error
    }{
        {
            name: "empty email",
            cmd:  CreateUserCommand{Email: ""},
            wantErr: user.ErrInvalidEmail,
        },
        {
            name: "invalid email format",
            cmd:  CreateUserCommand{Email: "invalid"},
            wantErr: user.ErrInvalidEmail,
        },
    }
    
    for _, tt := range tests {
        t.Run(tt.name, func(t *testing.T) {
            // Test implementation
        })
    }
}
```

### 8.3 Integration Test Structure

```go
func TestPostgresUserRepository_Create(t *testing.T) {
    // Setup test database
    db := setupTestDB(t)
    defer teardownTestDB(t, db)
    
    repo := NewPostgresUserRepository(db)
    
